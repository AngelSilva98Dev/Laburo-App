# En tu computadora no hace falta nada de esto:
# los datos se guardan en data/laburo.db, no se cobra y los emails se muestran en la consola.
# Para publicar, cargá estas variables en tu hosting (por ejemplo, Vercel → Settings → Environment Variables).

# ── Base de datos en la nube (Turso) ── obligatorio para publicar
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── Dirección pública del sitio, sin barra al final ── obligatorio para publicar
# Ej: https://laburoapp.com.ar
URL_PUBLICA=

# ── Suscripción con Mercado Pago ──
# Mientras MP_ACCESS_TOKEN esté vacío NO se cobra y nadie se bloquea al terminar la prueba.
# Access Token de producción: Mercado Pago → Tus integraciones → tu aplicación → Credenciales de producción.
MP_ACCESS_TOKEN=
# Clave secreta del webhook (Tus integraciones → Webhooks). Recomendado.
MP_WEBHOOK_SECRET=
# Precio mensual en pesos y días de prueba gratis.
PRECIO_MENSUAL=15000
DIAS_PRUEBA=14

# ── Emails (recuperar contraseña) con Resend ──
RESEND_API_KEY=
# Tiene que ser de un dominio verificado en Resend. Ej: Laburo <hola@laburoapp.com.ar>
EMAIL_REMITENTE=

# ── Datos del titular, para Términos y Política de privacidad ──
LEGAL_TITULAR=
LEGAL_CUIT=
LEGAL_DOMICILIO=
EMAIL_CONTACTO=
